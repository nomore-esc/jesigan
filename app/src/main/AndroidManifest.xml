<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vehicle SDK · Gear (기어 P = 주차 완료) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- NaviHelper SDK: 정보 조회 / 경유지 추가 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 서울 열린데이터 실시간 주차 대수 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_app"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Jesigan">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <!-- 주행 중 화면: 숫자 하나 + 음성만 → 운전자 주의분산 최적화(Distraction Optimized) 선언 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
