<?xml version="1.0" encoding="utf-8"?>
<!-- 차량 화면 (Pleos Connect 2560x1440 mdpi). 왼쪽: 경로·주차장 후보·SDK 활동, 오른쪽: 문 앞 도착 시각 카드, 아래: 시연 컨트롤 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="40dp">

        <!-- ===== 왼쪽 ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="40dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/fg"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/fg"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textColor="@color/fg"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/sub"
                android:textSize="26sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="주차장 후보 · 문 앞 도착 순"
                android:textColor="@color/sub"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/lotList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SDK 활동"
                android:textColor="@color/sub"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvSdk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/sub"
                android:textSize="19sp" />
        </LinearLayout>

        <!-- ===== 오른쪽: 메인 카드 ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="40dp">

            <TextView
                android:id="@+id/tvLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/sub"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvBig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="@color/fg"
                android:textSize="150sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="8dp"
                android:textColor="@color/fg"
                android:textSize="60sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/bar"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="36dp"
                android:orientation="horizontal">

                <View android:id="@+id/barDrive" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/blue" />
                <View android:layout_width="4dp" android:layout_height="match_parent" />
                <View android:id="@+id/barPark" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/orange" />
                <View android:layout_width="4dp" android:layout_height="match_parent" />
                <View android:id="@+id/barWalk" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/walk" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLegend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/sub"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/optCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="32dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOptTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fg"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOptSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/sub"
                        android:textSize="24sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOptTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/green"
                    android:textSize="52sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSecondary"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="0.6"
                    android:background="@drawable/bg_btn_secondary"
                    android:gravity="center"
                    android:textColor="@color/fg"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/blue"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 시연 컨트롤 (실차에서는 숨김) ===== -->
    <HorizontalScrollView
        android:id="@+id/demoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/demoButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="40dp"
            android:paddingVertical="18dp" />
    </HorizontalScrollView>
</LinearLayout>
